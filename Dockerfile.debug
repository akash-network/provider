# trixie: the bundled akt release binary needs glibc >= 2.38 (bookworm has 2.36)
FROM golang:1.26.10-trixie
LABEL "org.opencontainers.image.source"="https://github.com/akash-network/provider"

COPY provider-services /usr/bin/

# akt CLI, installed per architecture by `make akt`. The binary must be
# built for the image's platform: buildx/qemu would happily run a foreign-arch
# binary, so check the platform compiled into it rather than just running it.
ARG TARGETARCH
COPY .cache/akt/linux_${TARGETARCH}/akt /usr/bin/akt
RUN test -n "${TARGETARCH}" \
 && akt version --long | grep -Eq "^platform:[[:space:]]+linux/${TARGETARCH}$"

ENV DEBIAN_FRONTEND=noninteractive

# ca-certificates must be at least the build that dropped the emSign ECC Root CA - G3
# and Sectigo AAA roots (eMudhra intermediate key compromise, October 2026).
RUN \
    go install github.com/go-delve/delve/cmd/dlv@latest \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
    tini \
    jq \
    bc \
    netcat-traditional \
    mawk \
    curl \
    ca-certificates \
    pci.ids \
 && rm -rf /var/lib/apt/lists/* \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge 20250419+deb13u1

ENV DEBIAN_FRONTEND=""

# default port for provider API
EXPOSE 8443

# default for inventory operator API
EXPOSE 8080

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["provider-services", "--help"]
